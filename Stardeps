<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Mini App</title>

  <script src="https://telegram.org/js/telegram-web-app.js"></script>

  <style>
    body {
      font-family: Arial;
      text-align: center;
      margin-top: 100px;
    }
    button {
      font-size: 18px;
      padding: 10px 20px;
    }
  </style>
</head>

<body>

<h1 id="text">Загрузка...</h1>

<button onclick="tap()">Нажми</button>

<script>
  const tg = window.Telegram.WebApp;
  tg.expand();

  const user = tg.initDataUnsafe.user;
  document.getElementById("text").innerText =
    "Привет, " + user.first_name;

  function tap() {
    alert("Mini App работает!");
  }
</script>

</body>
</html>